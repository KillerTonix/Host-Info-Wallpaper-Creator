<Window x:Class="Host_Info_Wallpaper_Creator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Host_Info_Wallpaper_Creator"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Width="520"
        Height="630"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B1120"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI"
        FontSize="13"
        Title="Host Info Wallpaper Creator">
    <Window.Resources>

        <!-- Theme colors -->
        <SolidColorBrush x:Key="PanelBrush" Color="#151F32"/>
        <SolidColorBrush x:Key="InputBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="BorderBrushDark" Color="#2B3A52"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8"/>

        <!-- Rounded buttons -->
        <Style x:Key="ModernButton"
               TargetType="Button">
            <Setter Property="Background" Value="#26364F"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#354862"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#344968"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action -->
        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>

        <!-- Dark text fields -->
        <Style TargetType="TextBox">
            <Setter Property="Background"
                    Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <!-- Radio buttons -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Checkboxes -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>

        <!-- Section headers -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#93C5FD"/>
            <Setter Property="Background"
                    Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="9,9,0,0"
                                    Padding="12,9">
                                <ContentPresenter
                                    ContentSource="Header"
                                    RecognizesAccessKey="True"/>
                            </Border>

                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1,0,1,1"
                                    CornerRadius="0,0,9,9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="46"
                    Height="46"
                    Background="#1D3762"
                    CornerRadius="12">
                <TextBlock Text="&#xE7F4;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="25"
                           Foreground="#60A5FA"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                <TextBlock Text="Host Info Wallpaper Creator"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="#F8FAFC"/>
                <TextBlock Text="SERVER PERSONALIZATION"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#64748B"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <Border Grid.Column="2"
                    Background="#172A25"
                    BorderBrush="#285342"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,5"
                    VerticalAlignment="Center">
                <TextBlock Text="Artur Tonoyan"
                           Foreground="#4ADE80"
                           FontSize="10"
                           FontWeight="Bold"/>
            </Border>
        </Grid>

        <!-- Background -->
        <GroupBox Header="BACKGROUND"
                  Grid.Row="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="rbUseImage"
                             Content="Image"
                             IsChecked="True"
                             GroupName="BackgroundType"
                             Grid.Row="0"
                             Grid.Column="0"/>

                <TextBox x:Name="txtImagePath"
                         Text="C:\Windows\Web\Screen\img105.jpg"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,0,8,0"/>

                <Button x:Name="btnBrowse"
                        Content="Browse"
                        Style="{StaticResource ModernButton}"
                        Click="BtnBrowse_Click"
                        Grid.Row="0"
                        Grid.Column="2"/>

                <RadioButton x:Name="rbUseColor"
                             Content="Solid color"
                             GroupName="BackgroundType"
                             Grid.Row="2"
                             Grid.Column="0"/>

                <xctk:ColorPicker Grid.Row="2" Grid.Column="1" x:Name="cpBgColor" Margin="0,0,8,0"/>

            </Grid>
        </GroupBox>

        <!-- Typography -->
        <GroupBox Header="TYPOGRAPHY"
                  Grid.Row="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="105"/>
                </Grid.ColumnDefinitions>            

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="FONT FAMILY"
                        Foreground="#94A3B8"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Margin="0,0,0,5"/>
                    <TextBox x:Name="txtFontFamily"
                      Text="Arial"
                      Height="32"
                      MaxLength="3"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="HOST NAME SIZE"
                               Foreground="#94A3B8"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="numBigFont"
                             Text="80"
                             Height="32"
                             MaxLength="3"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="INFO SIZE"
                               Foreground="#94A3B8"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="numSmallFont"
                             Text="25"
                             Height="32"
                             MaxLength="3"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Information toggles -->
        <GroupBox Header="INFORMATION DISPLAY"
                  Grid.Row="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <CheckBox x:Name="chkShowHost"
                              Content="Hostname"
                              IsChecked="True"/>
                    <CheckBox x:Name="chkShowIp"
                              Content="IP Address"
                              IsChecked="True"/>
                    <CheckBox x:Name="chkShowCores"
                              Content="CPU Cores"
                              IsChecked="True"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="chkShowRam"
                              Content="RAM"
                              IsChecked="True"/>
                    <CheckBox x:Name="chkShowDrives"
                              Content="Local Drives (Space)"
                              IsChecked="True"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Bottom action -->
        <StackPanel Grid.Row="6">
            <Button x:Name="btnApply"
                    Content="Apply Wallpaper"
                    FontFamily="Segoe UI"
                    Style="{StaticResource PrimaryButton}"
                    Height="50"
                    Click="BtnApply_Click"/>

            <TextBlock Text="Customize your server desktop in seconds."
                       Foreground="#64748B"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
